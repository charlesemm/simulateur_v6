# Copie ce fichier en ".env" et remplace les valeurs. Le fichier .env ne va JAMAIS dans Git.
# Mot de passe aleatoire (PowerShell) : -join ((48..57)+(97..122) | Get-Random -Count 24 | % {[char]$_})

# --- Base de donnees ---
DB_NAME=simulateur
DB_USER=simulateur
DB_PASSWORD=remplace-moi

# --- Securite ---
API_KEY=remplace-moi-cle-api
ADMIN_INITIAL_PASSWORD=remplace-moi-admin
SESSION_COOKIE_SECURE=false

# --- Lancer l'application depuis IntelliJ (hors conteneur) ---
# En conteneur, ces deux valeurs sont fixees par compose.yaml.
DB_URL=jdbc:postgresql://localhost:5432/simulateur?reWriteBatchedInserts=true
TOXIPROXY_URL=http://localhost:8474

# --- Observabilite (profil optionnel) ---
GRAFANA_ADMIN_PASSWORD=remplace-moi-grafana
